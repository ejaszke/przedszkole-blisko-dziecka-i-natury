  <!-- BLISKO DZIECKA -->
  <section class="section idea-content" id="idea-content">
    <div class="row-content idea-row">
      <div class="col-text">
        <div class="idea-copy" id="idea-copy-child" set:html={md(data.blisko_dziecka_text)}></div>
      </div>
      <div class="col-img idea-feature">
        <h2 class="idea-feature-title">blisko<br>dziecka</h2>
        <img src="assets/blisko-dziecka.png" alt="Lisie ilustracje symbolizujące bliskość z dzieckiem" class="idea-feature-art">
      </div>
    </div>

    <!-- BLISKO NATURY -->
    <div class="row-content reverse idea-row">
      <div class="col-text">
        <div class="idea-copy" id="idea-copy-nature" set:html={md(data.blisko_natury_text)}></div>
      </div>
      <div class="col-img idea-feature">
        <h2 class="idea-feature-title">blisko<br>natury</h2>
        <img src="assets/blisko-natury.png" alt="Lis przy drzewie – symbol bliskości z naturą" class="idea-feature-art">
      </div>
    </div>

    <!-- W PRZYJAZNYM OTOCZENIU -->
    <div class="row-content idea-row">
      <div class="col-text">
        <div class="idea-copy" id="idea-copy-surroundings" set:html={md(data.w_przyjaznym_otoczeniu_text)}></div>
      </div>
      <div class="col-img idea-feature">
        <h2 class="idea-feature-title">w przyjaznym<br>otoczeniu</h2>
        <img src="assets/w-przyjazdnym-otoczeniu.png" alt="Kolorowa tęcza – symbol przyjaznego otoczenia" class="idea-feature-art idea-feature-art--small">
      </div>
    </div>

    <!-- W CIEKAWY SPOSÓB -->
    <div class="row-content reverse idea-row">
      <div class="col-text">
        <div class="idea-copy" id="idea-copy-inspiring" set:html={md(data.w_ciekawy_sposob_text)}></div>
      </div>
      <div class="col-img idea-feature">
        <h2 class="idea-feature-title">w ciekawy<br>i inspirujący<br>sposób</h2>
        <img src="assets/w-ciekawy-i-inspirujacy-sposob.png" alt="Ślady łap – symbol odkrywania" class="idea-feature-art idea-feature-art--tiny">
      </div>
    </div>

    <!-- PRYWATNOŚĆ I WSPÓŁPRACA -->
    <div class="idea-final">
      <div class="idea-final-copy">
        <h2 class="idea-final-title" set:html={data.final_title}></h2>
        <p>{data.final_text}</p>
      </div>
      <div class="idea-final-art">
        <img src="assets/w-poszukiwaniu-prywatnosci.png" alt="Lisy rozmawiające o współpracy">
      </div>
    </div>

    <div class="idea-gallery">
