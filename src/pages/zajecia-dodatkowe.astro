---
import { getEntry } from 'astro:content';
import { md } from '../lib/md';

const entry = await getEntry('strony', 'zajecia-dodatkowe');
if (!entry) throw new Error('Missing content entry: strony/zajecia-dodatkowe');
const { data } = entry;
const activities = (data.activities || []) as Array<{ id: string; title: string; image: string; text: string }>;
const midpoint = Math.ceil(activities.length / 2);
const indexColA = activities.slice(0, midpoint);
const indexColB = activities.slice(midpoint);
